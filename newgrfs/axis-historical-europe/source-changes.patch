+    1: ${industry.id}_check_location_upstream;
+    return CB_RESULT_LOCATION_DISALLOW;
+}
+</tal:history>
+<tal:unmodified condition="getattr(industry, 'historical_rule', None) is None">
+switch(FEAT_INDUSTRIES, SELF, ${industry.id}_check_location, 1) {
+    1: ${industry.id}_check_location_upstream;
+    return CB_RESULT_LOCATION_DISALLOW;
+}
+</tal:unmodified>
